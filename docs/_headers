# Защитные заголовки для всех страниц (Cloudflare): запрет встраивания сайта в чужие страницы, запрет посторонних скриптов,
# запрет определения типа файла «на лету», сайт не передаёт адреса страниц при переходах, камера/микрофон/геолокация не нужны.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://solitary-fire-f032.a-rastuninbpan.workers.dev; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Заголовки для Cloudflare Pages (GitHub Pages этот файл просто игнорирует):
# сами страницы и настройки всегда свежие, чтобы обновления доходили сразу; картинки можно кешировать надолго.
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/style.css
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/*.webp
  Cache-Control: public, max-age=604800
/version.js
  Cache-Control: no-cache
/demo.js
  Cache-Control: no-cache
