# Токены ботов. Достаточно одного из них, можно оба.
# Telegram: создать бота у @BotFather. MAX: business.max.ru -> Чат-боты
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
# ID Google-таблицы (из ссылки .../spreadsheets/d/<ID>/edit)
SHEET_ID=
# JSON-ключ сервисного аккаунта Google (доступ к таблице «Читатель» достаточно)
GOOGLE_CREDENTIALS_FILE=service-account.json
# Вместо файла можно передать весь JSON строкой (так делает GitHub Actions)
GOOGLE_CREDENTIALS_JSON=
TIMEZONE=Europe/Moscow
CHECK_INTERVAL_SEC=60
DB_PATH=planner.db
